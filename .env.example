# Copy to backend/.env and replace database credentials for your local PostgreSQL instance.
# These are development placeholders. Never use them outside a local machine.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://healthtrace:change-me@127.0.0.1:5432/healthtrace
TEST_DATABASE_URL=postgresql+psycopg://healthtrace:change-me@127.0.0.1:5432/healthtrace_test

# Development uses ephemeral JWT keys when omitted (sessions end when the backend restarts).
# Set distinct, randomly generated values for a persistent local environment; production requires both.
# JWT_SECRET=
# JWT_REFRESH_SECRET=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
STORAGE_PATH=./storage_data
MAX_UPLOAD_MB=15
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
AI_PROVIDER=mock


# Document-type classifier (scikit-learn). Suggestions only; trained on synthetic data. See docs/document-classification.md
DOC_CLASSIFIER_ENABLED=true
# DOC_CLASSIFIER_ARTIFACT_DIR=./ml/artifacts/document_classifier
DOC_CLASSIFIER_MIN_SCORE=0.5
DOC_CLASSIFIER_MAX_CHARS=20000
