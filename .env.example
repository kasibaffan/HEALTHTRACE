# Copy to .env and fill in as needed. The app must run fully with none of this set.

# off | mock | live (SPEC.md section 6.9)
AWS_MODE=off
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/medguard/alerts
SNS_TOPIC_ARN=

# Enables POST /api/demo/inject and the frontend demo panel.
DEMO_MODE=true

# Paths default to <repo root>/data/{logs,medguard.db,control.json} and only
# need overriding for a non-standard layout. Use absolute paths if you do.
# LOG_DIR=
# DB_PATH=
# CONTROL_FILE=

# Shown in the UI; one deployment watches one project environment.
PROJECT_NAME=Medicaid Pipeline
ENVIRONMENT=local
# Browser origins allowed cross-origin (not needed when the UI is served by the backend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# When set, acknowledge/resolve/mute/demo/AWS-test endpoints require X-Operator-Token.
OPERATOR_TOKEN=
